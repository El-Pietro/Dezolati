rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Profily: číst může každý přihlášený (hledání kámošů, jejich hospodský den), zapisovat jen svůj.
    match /Users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
    }

    // Jednotlivé zápisy (log): jen vlastní, jen vytvořit.
    match /Drinks/{id} {
      allow read: if signedIn() && resource.data.UserId == me();
      allow create: if signedIn() && request.resource.data.UserId == me();
    }

    // Denní součty: číst může každý přihlášený (statistiky kámošů), zapisovat jen do svých.
    match /DailyDrinks/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.resource.data.UserId == me()
                            && id.matches(me() + '_.*');
      allow delete: if signedIn() && resource.data.UserId == me();
    }

    // Přátelství: UserId = žadatel, FriendId = adresát, Members = [UserId, FriendId].
    match /Friends/{id} {
      function isMember(data) {
        return me() in data.get('Members', []) || data.UserId == me() || data.FriendId == me();
      }
      function membersOk(data) {
        return data.Members == [data.UserId, data.FriendId];
      }

      allow read: if signedIn() && isMember(resource.data);

      // žádost zakládá žadatel, vždy jako Pending
      allow create: if signedIn()
                    && request.resource.data.UserId == me()
                    && request.resource.data.Status == 'Pending'
                    && membersOk(request.resource.data);

      // oba můžou upravovat (přezdívky, migrace), ale nikdo nemění účastníky;
      // stav (přijetí) mění jen adresát
      allow update: if signedIn()
                    && isMember(resource.data)
                    && request.resource.data.UserId == resource.data.UserId
                    && request.resource.data.FriendId == resource.data.FriendId
                    && membersOk(request.resource.data)
                    && (request.resource.data.Status == resource.data.Status
                        || resource.data.FriendId == me());

      // odmítnutí / zrušení = smazání, může kterýkoli z dvojice
      allow delete: if signedIn() && isMember(resource.data);
    }

    // Profily hospod (id = OSM id, např. n123456): upravit může každý přihlášený,
    // ale jen spolu se záznamem v historii (PubEdits/{EditId} ve stejné dávce).
    match /Pubs/{pubId} {
      function textOk(d, f) { return !(f in d) || (d[f] is string && d[f].size() <= 300); }

      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.resource.data.keys().hasOnly(
                                 ['PubId', 'Name', 'Taps', 'Prices', 'Hours', 'Note',
                                  'UpdatedAt', 'UpdatedBy', 'UpdatedByNick', 'EditId'])
                            && request.resource.data.PubId == pubId
                            && request.resource.data.UpdatedBy == me()
                            && textOk(request.resource.data, 'Taps')
                            && textOk(request.resource.data, 'Prices')
                            && textOk(request.resource.data, 'Hours')
                            && textOk(request.resource.data, 'Note')
                            && getAfter(/databases/$(database)/documents/PubEdits/$(request.resource.data.EditId)).data.PubId == pubId
                            && getAfter(/databases/$(database)/documents/PubEdits/$(request.resource.data.EditId)).data.By == me();
      allow delete: if false;
    }

    // Historie úprav: jen přidávat, nikdo nemaže ani nepřepisuje.
    match /PubEdits/{editId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(
                         ['PubId', 'By', 'ByNick', 'At', 'Taps', 'Prices', 'Hours', 'Note'])
                    && request.resource.data.By == me()
                    && request.resource.data.At is timestamp;
      allow update, delete: if false;
    }
  }
}
