rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // Profily: číst může každý přihlášený (hledání kámošů, jejich hospodský den), zapisovat jen svůj.
    match /Users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
    }

    // Jednotlivé zápisy (log): jen vlastní, jen vytvořit.
    match /Drinks/{id} {
      allow read: if signedIn() && resource.data.UserId == me();
      allow create: if signedIn() && request.resource.data.UserId == me();
    }

    // Denní součty: číst může každý přihlášený (statistiky kámošů), zapisovat jen do svých.
    match /DailyDrinks/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.resource.data.UserId == me()
                            && id.matches(me() + '_.*');
      allow delete: if signedIn() && resource.data.UserId == me();
    }

    // Přátelství: UserId = žadatel, FriendId = adresát, Members = [UserId, FriendId].
    match /Friends/{id} {
      function isMember(data) {
        return me() in data.get('Members', []) || data.UserId == me() || data.FriendId == me();
      }
      function membersOk(data) {
        return data.Members == [data.UserId, data.FriendId];
      }

      allow read: if signedIn() && isMember(resource.data);

      // žádost zakládá žadatel, vždy jako Pending
      allow create: if signedIn()
                    && request.resource.data.UserId == me()
                    && request.resource.data.Status == 'Pending'
                    && membersOk(request.resource.data);

      // oba můžou upravovat (přezdívky, migrace), ale nikdo nemění účastníky;
      // stav (přijetí) mění jen adresát
      allow update: if signedIn()
                    && isMember(resource.data)
                    && request.resource.data.UserId == resource.data.UserId
                    && request.resource.data.FriendId == resource.data.FriendId
                    && membersOk(request.resource.data)
                    && (request.resource.data.Status == resource.data.Status
                        || resource.data.FriendId == me());

      // odmítnutí / zrušení = smazání, může kterýkoli z dvojice
      allow delete: if signedIn() && isMember(resource.data);
    }
  }
}
