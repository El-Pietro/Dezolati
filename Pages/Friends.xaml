<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Dezolati.Controls"
             xmlns:models="clr-namespace:Dezolati.Models"
             x:Class="Dezolati.Pages.Friends">
    <Grid RowDefinitions="Auto, *">
        <Image Grid.RowSpan="2" Source="{AppThemeBinding Light=woodlight.jpg, Dark=wooddark.jpg}" Aspect="AspectFill" />

        <!-- Android: místo tlačítka Zpět jen odsazení pod stavovou lištou (zpět = systémové tlačítko) -->
        <BoxView Grid.Row="0" HeightRequest="0" Color="Transparent" InputTransparent="True" Margin="{DynamicResource TopBarMargin}" />
        <!-- Windows a spol. systémové Zpět nemají → tam tlačítko zůstává -->
        <controls:PencilButton Grid.Row="0" Variant="Outline" Text="Zpět" IsVisible="{OnPlatform Default=True, Android=False}"
                               HorizontalOptions="Start" Margin="{DynamicResource TopBarMargin}" Clicked="OnZpetClicked" />

        <Border Grid.Row="1" Style="{StaticResource Listek}">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto, Auto, Auto" RowSpacing="8">

                <Label Grid.Row="0" Text="Kámoši" Style="{StaticResource Title}" />

                <!-- kdo mi připil na moje sezení -->
                <!-- jména jdou rozkliknout (statistiky), nová připití se připisují hned z oznámení -->
                <FlexLayout Grid.Row="1" x:Name="CheersBox" Wrap="Wrap" AlignItems="Center" IsVisible="False" />

                <!-- Žádosti, které čekají na mě -->
                <Label Grid.Row="2" x:Name="PendingHeader" Text="Chtějí se s tebou kamarádit:"
                       Style="{StaticResource FieldLabel}" IsVisible="False" />
                <CollectionView Grid.Row="3" x:Name="PendingRequestsList" SelectionMode="None"
                                IsVisible="False" MaximumHeightRequest="180">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:FriendsModel">
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6" Padding="0,4">
                                <Label Text="{Binding Display}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <controls:PencilButton Grid.Column="1" Text="✔" Variant="Primary"
                                                       WidthRequest="56" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                                       Clicked="OnAcceptRequestClicked" CommandParameter="{Binding RequestId}" />
                                <controls:PencilButton Grid.Column="2" Text="✖" Variant="Danger"
                                                       WidthRequest="56" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                                       Clicked="OnRejectRequestClicked" CommandParameter="{Binding RequestId}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Seznam přátel: kdo pije, je nahoře s emoji a místem; ťuk na jméno = statistiky -->
                <ScrollView Grid.Row="4">
                    <VerticalStackLayout Spacing="2">
                        <VerticalStackLayout x:Name="FriendsStack" Spacing="2">
                            <Label x:Name="EmptyLabel" Text="Zatím nikdo. Piješ sám?" Style="{StaticResource Heading}"
                                   HorizontalOptions="Center" Margin="0,20" IsVisible="False" />
                        </VerticalStackLayout>

                        <!-- Možná znáš: kámoši kámošů (z adresáře, sbalené) -->
                        <Grid ColumnDefinitions="*, Auto" Margin="0,14,0,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSuggestTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="Možná znáš" Style="{StaticResource FieldLabel}" />
                            <Label x:Name="SuggestToggle" Grid.Column="1" Text="(ukázat)" Style="{StaticResource Small}"
                                   TextColor="{StaticResource InkSoft}" VerticalOptions="End" Padding="12,0,4,2" />
                        </Grid>
                        <VerticalStackLayout x:Name="SuggestStack" Spacing="2" IsVisible="False" />
                    </VerticalStackLayout>
                </ScrollView>

                <!-- našeptávač přezdívek (hledá se v telefonu) -->
                <VerticalStackLayout Grid.Row="5" x:Name="SearchList" Spacing="0" IsVisible="False" />

                <!-- Přidání přítele -->
                <Entry Grid.Row="6" x:Name="NicknameEntry" Placeholder="Přezdívka kámoše"
                       Focused="OnNickFocused" TextChanged="OnNickTextChanged" />
                <controls:PencilButton Grid.Row="7" x:Name="AddButton" Text="Poslat žádost" Variant="Primary"
                                       Clicked="OnAddFriendClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
