<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Dezolati.Controls"
             x:Class="Dezolati.Pages.Hospoda"
             Title="Hospoda">
    <Grid RowDefinitions="Auto, *">
        <Image Grid.RowSpan="2" Source="{AppThemeBinding Light=woodlight.jpg, Dark=wooddark.jpg}" Aspect="AspectFill" />

        <BoxView Grid.Row="0" HeightRequest="0" Color="Transparent" InputTransparent="True" Margin="{DynamicResource TopBarMargin}" />
        <controls:PencilButton Grid.Row="0" Variant="Outline" Text="Zpět" IsVisible="{OnPlatform Default=True, Android=False}"
                               HorizontalOptions="Start" Margin="{DynamicResource TopBarMargin}" Clicked="OnZpetClicked" />

        <Border Grid.Row="1" Style="{StaticResource Listek}">
            <ScrollView>
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="NameLabel" Style="{StaticResource Title}" />
                    <Label x:Name="InfoLabel" Style="{StaticResource Small}" HorizontalTextAlignment="Center" />
                    <Label x:Name="ClosedLabel" Text="Natrvalo zavřeno" Style="{StaticResource Heading}" TextColor="#A01C1C"
                           HorizontalTextAlignment="Center" IsVisible="False" />
                    <Label x:Name="OsmLabel" Style="{StaticResource Small}" HorizontalTextAlignment="Center" IsVisible="False" />

                    <!-- oblíbená + pozvat kámoše -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,6,0,0">
                        <controls:PencilButton x:Name="FavButton" Grid.Column="0" Text="☆ Oblíbená" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               Clicked="OnFavClicked" />
                        <controls:PencilButton x:Name="InviteButton" Grid.Column="1" Text="Pozvat kámoše" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               Clicked="OnInviteClicked" />
                    </Grid>

                    <!-- kontakty z OpenStreetMap -->
                    <Grid x:Name="ContactBox" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,6,0,0" IsVisible="False">
                        <controls:PencilButton x:Name="WebButton" Grid.Column="0" Text="Web" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               Clicked="OnWebClicked" />
                        <controls:PencilButton x:Name="CallButton" Grid.Column="1" Text="Zavolat" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               Clicked="OnCallClicked" />
                    </Grid>
                    <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Pencil}" />

                    <!-- zobrazení -->
                    <VerticalStackLayout x:Name="ViewBox" Spacing="2" Margin="0,10,0,0">
                        <Label Text="Co točí:" Style="{StaticResource FieldLabel}" />
                        <Label x:Name="TapsLabel" Style="{StaticResource Body}" />
                        <Label x:Name="TapsSourceLabel" Text="podle OpenStreetMap" Style="{StaticResource Small}" IsVisible="False" />
                        <Label Text="Ceny:" Style="{StaticResource FieldLabel}" />
                        <Label x:Name="PriceNumbersLabel" Style="{StaticResource Body}" IsVisible="False" />
                        <Label x:Name="PricesLabel" Style="{StaticResource Body}" />
                        <Label Text="Otvíračka:" Style="{StaticResource FieldLabel}" />
                        <Label x:Name="HoursLabel" Style="{StaticResource Body}" />
                        <Label x:Name="HoursSourceLabel" Text="podle OpenStreetMap" Style="{StaticResource Small}" IsVisible="False" />
                        <Label Text="Poznámka:" Style="{StaticResource FieldLabel}" />
                        <Label x:Name="NoteLabel" Style="{StaticResource Body}" />
                        <Label x:Name="UpdatedLabel" Style="{StaticResource Small}" Margin="0,8,0,0" />

                        <controls:PencilButton x:Name="EditButton" Text="Upravit" Variant="Primary"
                                               Margin="0,12,0,0" Clicked="OnEditClicked" />
                        <controls:PencilButton x:Name="HistoryButton" Text="Historie změn" Variant="Secondary"
                                               Clicked="OnHistoryClicked" />
                        <VerticalStackLayout x:Name="HistoryList" Spacing="8" Margin="0,8,0,0" />

                        <!-- zavření / smazání -->
                        <controls:PencilButton x:Name="ClosedButton" Text="Natrvalo zavřeno" Variant="Danger"
                                               Margin="0,16,0,0" Clicked="OnClosedClicked" />
                        <controls:PencilButton x:Name="DeleteButton" Text="Smazat podnik" Variant="Danger"
                                               IsVisible="False" Clicked="OnDeleteClicked" />
                    </VerticalStackLayout>

                    <!-- úprava -->
                    <VerticalStackLayout x:Name="EditBox" Spacing="2" Margin="0,10,0,0" IsVisible="False">
                        <Label Text="Název:" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="NameEntry" MaxLength="80" />
                        <Label Text="Co točí:" Style="{StaticResource FieldLabel}" />
                        <Editor x:Name="TapsEntry" Placeholder="Plzeň 12°, Kozel 11°…" AutoSize="TextChanges" MaxLength="300" />
                        <Label Text="Ceny v Kč (pro výpočet útraty):" Style="{StaticResource FieldLabel}" />
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                            <Entry x:Name="PricePivoEntry" Grid.Column="0" Placeholder="pivo 0,5" Keyboard="Numeric" MaxLength="4" />
                            <Entry x:Name="PriceVinoEntry" Grid.Column="1" Placeholder="víno 2 dcl" Keyboard="Numeric" MaxLength="4" />
                            <Entry x:Name="PricePanakEntry" Grid.Column="2" Placeholder="panák" Keyboard="Numeric" MaxLength="4" />
                        </Grid>
                        <Label Text="Ceny – poznámka:" Style="{StaticResource FieldLabel}" />
                        <Editor x:Name="PricesEntry" Placeholder="Plzeň 0,5 l = 62 Kč, Kozel 48 Kč" AutoSize="TextChanges" MaxLength="300" />
                        <Label Text="Otvíračka:" Style="{StaticResource FieldLabel}" />
                        <Editor x:Name="HoursEntry" Placeholder="Po–Čt 15–23, Pá–So 15–02" AutoSize="TextChanges" MaxLength="300" />
                        <Label Text="Poznámka:" Style="{StaticResource FieldLabel}" />
                        <Editor x:Name="NoteEntry" Placeholder="Zahrádka, šipky, hospodský je morous…" AutoSize="TextChanges" MaxLength="300" />

                        <controls:PencilButton x:Name="SaveButton" Text="Uložit" Variant="Primary"
                                               Margin="0,12,0,0" Clicked="OnSaveClicked" />
                        <controls:PencilButton Text="Zrušit" Variant="Secondary" Clicked="OnCancelEditClicked" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
