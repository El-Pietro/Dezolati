<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Dezolati.Controls"
             x:Class="Dezolati.Pages.Settings">
    <Grid RowDefinitions="Auto, *">
        <Image Grid.RowSpan="2" Source="{AppThemeBinding Light=woodlight.jpg, Dark=wooddark.jpg}" Aspect="AspectFill" />

        <!-- Android: místo tlačítka Zpět jen odsazení pod stavovou lištou (zpět = systémové tlačítko) -->
        <BoxView Grid.Row="0" HeightRequest="0" Color="Transparent" InputTransparent="True" Margin="{DynamicResource TopBarMargin}" />
        <!-- Windows a spol. systémové Zpět nemají → tam tlačítko zůstává -->
        <controls:PencilButton Grid.Row="0" Variant="Outline" Text="Zpět" IsVisible="{OnPlatform Default=True, Android=False}"
                               HorizontalOptions="Start" Margin="{DynamicResource TopBarMargin}" Clicked="OnZpetClicked" />

        <Border Grid.Row="1" Style="{StaticResource Listek}">
            <ScrollView>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Nastavení píče" Style="{StaticResource Title}" />

                    <Label Text="Jméno:" Style="{StaticResource FieldLabel}" />
                    <Entry x:Name="NameEntry" Placeholder="Tvoje jméno" />

                    <Label Text="Přezdívka:" Style="{StaticResource FieldLabel}" />
                    <Entry x:Name="NicknameEntry" Placeholder="Podle ní tě najdou kámoši" />

                    <!-- Volby: vybraná = hnědá pastelka, nevybraná = bledá tužka (přepíná code-behind) -->
                    <Label Text="Pohlaví:" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <controls:PencilButton x:Name="GenderPic" Grid.Column="0" Text="Píč"
                                               Variant="Secondary" CommandParameter="Píč" Clicked="OnGenderClicked" />
                        <controls:PencilButton x:Name="GenderPicka" Grid.Column="1" Text="Píčka"
                                               Variant="Secondary" CommandParameter="Píčka" Clicked="OnGenderClicked" />
                    </Grid>

                    <Label Text="Typ píče:" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <controls:PencilButton x:Name="TypePivo" Grid.Column="0" Text="Pivopíč/ka"
                                               Variant="Secondary" CommandParameter="Pivopíč/ka" Clicked="OnTypeClicked" />
                        <controls:PencilButton x:Name="TypeVino" Grid.Column="1" Text="Vínopíč/ka"
                                               Variant="Secondary" CommandParameter="Vínopíč/ka" Clicked="OnTypeClicked" />
                    </Grid>

                    <!-- připomínka po X minutách bez zápisu (ukládá se hned, jen v tomhle telefonu) -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Připomínat, když nic nezapíšu:" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Column="1" Text="(info)" Style="{StaticResource Small}" TextColor="{StaticResource InkSoft}"
                               VerticalOptions="End" Padding="12,0,4,2">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInfoTapped" CommandParameter="reminder" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="6">
                        <controls:PencilButton x:Name="Rem0" Grid.Column="0" Text="Vyp" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="0" Clicked="OnReminderClicked" />
                        <controls:PencilButton x:Name="Rem20" Grid.Column="1" Text="20 min" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="20" Clicked="OnReminderClicked" />
                        <controls:PencilButton x:Name="Rem30" Grid.Column="2" Text="30 min" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="30" Clicked="OnReminderClicked" />
                        <controls:PencilButton x:Name="Rem60" Grid.Column="3" Text="60 min" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="60" Clicked="OnReminderClicked" />
                    </Grid>

                    <!-- oznámení od kámošů (posílá server) a „kde sedím“ – ukládá se hned do profilu -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Oznámení od kámošů:" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Column="1" Text="(info)" Style="{StaticResource Small}" TextColor="{StaticResource InkSoft}"
                               VerticalOptions="End" Padding="12,0,4,2">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInfoTapped" CommandParameter="notify" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <controls:PencilButton x:Name="NotifyOn" Grid.Column="0" Text="Chci" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="1" Clicked="OnNotifyClicked" />
                        <controls:PencilButton x:Name="NotifyOff" Grid.Column="1" Text="Nechci" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="0" Clicked="OnNotifyClicked" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Poznávat hospodu podle polohy:" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Column="1" Text="(info)" Style="{StaticResource Small}" TextColor="{StaticResource InkSoft}"
                               VerticalOptions="End" Padding="12,0,4,2">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInfoTapped" CommandParameter="detect" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <controls:PencilButton x:Name="DetectOn" Grid.Column="0" Text="Poznávat" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="1" Clicked="OnDetectClicked" />
                        <controls:PencilButton x:Name="DetectOff" Grid.Column="1" Text="Nepoznávat" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="0" Clicked="OnDetectClicked" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Hlásit kámošům, že piju:" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Column="1" Text="(info)" Style="{StaticResource Small}" TextColor="{StaticResource InkSoft}"
                               VerticalOptions="End" Padding="12,0,4,2">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInfoTapped" CommandParameter="share" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                        <controls:PencilButton x:Name="ShareWhere" Grid.Column="0" Text="I kde" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="2" Clicked="OnShareClicked" />
                        <controls:PencilButton x:Name="ShareYes" Grid.Column="1" Text="Že piju" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="1" Clicked="OnShareClicked" />
                        <controls:PencilButton x:Name="ShareNo" Grid.Column="2" Text="Nehlásit" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="0" Clicked="OnShareClicked" />
                    </Grid>

                    <!-- domov: poloha jen v telefonu, nastavuje se na mapě -->
<Grid ColumnDefinitions="*, Auto">
                        <Label Text="Domov:" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Column="1" Text="(info)" Style="{StaticResource Small}" TextColor="{StaticResource InkSoft}"
                               VerticalOptions="End" Padding="12,0,4,2">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInfoTapped" CommandParameter="home" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <controls:PencilButton x:Name="HomeSetButton" Grid.Column="0" Text="Nastavit domov" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               Clicked="OnHomeSetClicked" />
                        <controls:PencilButton x:Name="HomeClearButton" Grid.Column="1" Text="Zapomenout" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               IsVisible="False" Clicked="OnHomeClearClicked" />
                    </Grid>

                    <!-- ceny pro útratu (jen v telefonu) -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Moje obvyklé ceny:" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Column="1" Text="(info)" Style="{StaticResource Small}" TextColor="{StaticResource InkSoft}"
                               VerticalOptions="End" Padding="12,0,4,2">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInfoTapped" CommandParameter="prices" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                        <Entry x:Name="PricePivoEntry" Grid.Column="0" Placeholder="pivo 0,5" Keyboard="Numeric" MaxLength="4"
                               TextChanged="OnPriceChanged" />
                        <Entry x:Name="PriceVinoEntry" Grid.Column="1" Placeholder="víno 2 dcl" Keyboard="Numeric" MaxLength="4"
                               TextChanged="OnPriceChanged" />
                        <Entry x:Name="PricePanakEntry" Grid.Column="2" Placeholder="panák" Keyboard="Numeric" MaxLength="4"
                               TextChanged="OnPriceChanged" />
                    </Grid>

                    <!-- orientační promile (vše jen v telefonu) -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Promile na lístku:" Style="{StaticResource FieldLabel}" />
                        <Label Grid.Column="1" Text="(info)" Style="{StaticResource Small}" TextColor="{StaticResource InkSoft}"
                               VerticalOptions="End" Padding="12,0,4,2">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInfoTapped" CommandParameter="promile" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <controls:PencilButton x:Name="PromileOn" Grid.Column="0" Text="Počítat" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="1" Clicked="OnPromileClicked" />
                        <controls:PencilButton x:Name="PromileOff" Grid.Column="1" Text="Nepočítat" Variant="Secondary"
                                               FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                               CommandParameter="0" Clicked="OnPromileClicked" />
                    </Grid>
                    <VerticalStackLayout x:Name="PromileBox" Spacing="4" IsVisible="False">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Label Text="Váha (kg):" Style="{StaticResource Small}" VerticalOptions="Center" />
                            <Entry x:Name="WeightEntry" Grid.Column="1" Placeholder="80" Keyboard="Numeric" MaxLength="3"
                                   TextChanged="OnWeightChanged" />
                        </Grid>
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                            <controls:PencilButton x:Name="Deg10" Grid.Column="0" Text="10°" Variant="Secondary"
                                                   FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                                   CommandParameter="10" Clicked="OnDegreesClicked" />
                            <controls:PencilButton x:Name="Deg11" Grid.Column="1" Text="11°" Variant="Secondary"
                                                   FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                                   CommandParameter="11" Clicked="OnDegreesClicked" />
                            <controls:PencilButton x:Name="Deg12" Grid.Column="2" Text="12°" Variant="Secondary"
                                                   FontSize="{DynamicResource FontButtonSmall}" HeightRequest="{DynamicResource ButtonHeightSmall}"
                                                   CommandParameter="12" Clicked="OnDegreesClicked" />
                        </Grid>
                    </VerticalStackLayout>

                    <controls:PencilButton Text="Uložit změny" Variant="Primary" Clicked="OnSaveClicked" Margin="0,24,0,0" />
                    <!-- verze a ruční kontrola aktualizace (instalace jde jen na Androidu) -->
                    <Label x:Name="VersionLabel" Style="{StaticResource Small}" Margin="0,18,0,0"
                           HorizontalTextAlignment="Center" />
                    <controls:PencilButton x:Name="UpdateButton" Text="Zkontrolovat aktualizace" Variant="Secondary"
                                           IsVisible="{OnPlatform Default=False, Android=True}"
                                           Clicked="OnCheckUpdateClicked" />
                    <controls:PencilButton Text="Co je nového" Variant="Secondary" Clicked="OnNewsClicked" />
                    <!-- jen pro správce: spotřeba Firebase proti bezplatným limitům -->
                    <controls:PencilButton x:Name="UsageButton" Text="Spotřeba" Variant="Secondary"
                                           IsVisible="False" Clicked="OnUsageClicked" />
                    <controls:PencilButton x:Name="OsmButton" Text="Návrhy do OSM" Variant="Secondary"
                                           IsVisible="False" Clicked="OnOsmClicked" />

                    <controls:PencilButton x:Name="LogoutButton" Text="Odhlásit se" Variant="Danger"
                                           Margin="0,10,0,0" Clicked="OnLogoutClicked" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
