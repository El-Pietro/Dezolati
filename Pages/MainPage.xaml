<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dezolati.Pages.MainPage"
             BackgroundImageSource="listek.png">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10" HorizontalOptions="Center" VerticalOptions="Start">

            <!-- Nadpis Dezoláti -->
            <Label Text="Dezoláti!"
                   FontSize="36"
                   HorizontalOptions="Center"
                   TextColor="black"
                   FontAttributes="Bold"
                   VerticalOptions="Start" />

            <!-- Počet dnešních piv -->
            <Label x:Name="SouhrnLabel"
                   Text="Dnešní spotřeba: 0 piv, 0 vín, 0 panáků"
                   FontSize="20"
                   HorizontalOptions="Center"
                   TextColor="Black" />

            <!-- Layout pro čárky -->
            <FlexLayout x:Name="ListekLayout"
                        Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="Center"
                        AlignItems="Start"
                        BackgroundColor="Transparent"
                        Margin="1"
                        Padding="1"
                        VerticalOptions="Center"
                        MaximumWidthRequest="250" />

            <!-- Tlačítko "+" -->
            <Button Text="+"
                    FontSize="24"
                    BackgroundColor="Yellow"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    WidthRequest="100"
                    Clicked="OnPridatClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
