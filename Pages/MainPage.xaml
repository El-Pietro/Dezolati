<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dezolati.Pages.MainPage">

    <AbsoluteLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">

        <!-- Pozadí stolu -->
        <Image Source="{AppThemeBinding Light=woodlight.jpg, Dark=wooddark.jpg}"
               Aspect="AspectFill"
               AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
               AbsoluteLayout.LayoutFlags="All" />

        <!-- Lístek -->
        <Frame BackgroundColor="Beige"
               CornerRadius="1"
               Padding="20"
               AbsoluteLayout.LayoutBounds="0.5, 0.4, 0.8, 0.75"
               AbsoluteLayout.LayoutFlags="All">

            <Grid RowDefinitions="Auto, Auto, *">
                <Label Text="Dezoláti!"
                       Grid.Row="0"
                       FontSize="46"
                       FontFamily="Caveat"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       FontAttributes="Bold" />

                <Label x:Name="SouhrnLabel"
                       Grid.Row="1"
                       Text="Načítám lístek…"
                       FontFamily="Caveat"
                       FontSize="24"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <ScrollView Grid.Row="2">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Pívo:" FontFamily="Caveat" FontSize="28" TextColor="Black" />
                        <FlexLayout x:Name="Pivo" Direction="Row" Wrap="Wrap" JustifyContent="Start"
                                    AlignItems="Start" Margin="5" Padding="5" />

                        <Label Text="Víno:" FontFamily="Caveat" FontSize="28" TextColor="Black" />
                        <FlexLayout x:Name="Vino" Direction="Row" Wrap="Wrap" JustifyContent="Start"
                                    AlignItems="Start" Margin="5" Padding="5" />

                        <Label Text="Panáky:" FontFamily="Caveat" FontSize="28" TextColor="Black" />
                        <FlexLayout x:Name="Panaky" Direction="Row" Wrap="Wrap" JustifyContent="Start"
                                    AlignItems="Start" Margin="5" Padding="5" />
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Frame>

        <!-- Velké plus pod lístkem -->
        <Button Text="+"
                FontSize="40"
                FontAttributes="Bold"
                WidthRequest="80"
                HeightRequest="80"
                CornerRadius="40"
                Padding="0"
                AbsoluteLayout.LayoutBounds="0.5, 0.88, 80, 80"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Clicked="OnPridatClicked" />

        <Button Text="Statistiky"
                AbsoluteLayout.LayoutBounds="0,1"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Margin="10"
                BorderColor="WhiteSmoke"
                TextColor="WhiteSmoke"
                Clicked="OnStatsClicked" />
        <Button Text="Nastavení"
                AbsoluteLayout.LayoutBounds="0.5,1"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Margin="10"
                BorderColor="WhiteSmoke"
                TextColor="WhiteSmoke"
                Clicked="OnSettingsClicked" />
        <Button Text="Přátelé"
                AbsoluteLayout.LayoutBounds="1,1"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Margin="10"
                BorderColor="WhiteSmoke"
                TextColor="WhiteSmoke"
                Clicked="OnFriendsClicked" />
    </AbsoluteLayout>
</ContentPage>
