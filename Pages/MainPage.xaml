<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Dezolati.Controls"
             x:Class="Dezolati.Pages.MainPage">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Pozadí stolu přes celou stránku -->
        <Image Grid.RowSpan="3"
               Source="{AppThemeBinding Light=woodlight.jpg, Dark=wooddark.jpg}"
               Aspect="AspectFill" />

        <!-- event: světýlka nahoře a ohňostroj – na stole, pod tlačítky (Services/EventScene.cs) -->
        <GraphicsView x:Name="BackFxView" Grid.RowSpan="3" InputTransparent="True" IsVisible="False" />

        <!-- Horní lišta: Hospody | Hry | Přátelé -->
        <Grid x:Name="TopBar" Grid.Row="0" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="6" Margin="{DynamicResource TopBarMargin}">
            <controls:PencilButton Grid.Column="0"
                                   Variant="Outline"
                                   Text="Hospody"
                                   Clicked="OnPubsClicked" />
            <controls:PencilButton Grid.Column="1"
                                   Variant="Outline"
                                   Text="Hry"
                                   HorizontalOptions="Center"
                                   Clicked="OnGamesClicked" />
            <!-- Přátelé + odznak s počtem čekajících žádostí -->
            <Grid Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center">
                <controls:PencilButton Variant="Outline"
                                       Text="Přátelé"
                                       Clicked="OnFriendsClicked" />
                <Border x:Name="FriendBadgeView"
                        IsVisible="False"
                        InputTransparent="True"
                        BackgroundColor="#C0392B"
                        Stroke="#F4E7C5"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 11"
                        MinimumWidthRequest="22"
                        HeightRequest="22"
                        Padding="5,0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        TranslationX="8"
                        TranslationY="-8">
                    <Label x:Name="FriendBadgeLabel"
                           TextColor="White"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- Lístek -->
        <Border x:Name="ListekBorder" Grid.Row="1" Style="{StaticResource Listek}" Margin="16,0,16,12">
            <Grid RowDefinitions="Auto, Auto, Auto, *">
                <!-- mokrá kolečka od piv a vín (pod vším ostatním, ťuknutí propouští) -->
                <GraphicsView x:Name="RingsView" Grid.RowSpan="4" InputTransparent="True" />
                <VerticalStackLayout Grid.Row="0" Spacing="0">
                    <Label Text="Dezoláti!" Style="{StaticResource Title}" />
                    <!-- cedulka eventu (Advent 2/4, Silvestr · do půlnoci …) -->
                    <Border x:Name="EventTag" IsVisible="False" HorizontalOptions="Center" Rotation="-1.5" Margin="0,2,0,4"
                            Padding="8,1,10,1" StrokeThickness="1.5" StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEventTagTapped" />
                        </Border.GestureRecognizers>
                        <!-- obsah propouští ťuknutí na celý rámeček (kreslicí plochy by si ho jinak nechaly) -->
                        <HorizontalStackLayout Spacing="7" InputTransparent="True">
                            <GraphicsView x:Name="EventTagIcon" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label x:Name="EventTagTitle" FontFamily="CaveatBold" FontSize="19" VerticalOptions="Center" />
                            <GraphicsView x:Name="EventTagCandles" WidthRequest="42" HeightRequest="20" VerticalOptions="Center" />
                            <Label x:Name="EventTagDetail" FontSize="18" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ťuknutí: ruční oprava místa („📍 …“), platí do 50 m -->
                <Label x:Name="SouhrnLabel"
                       Grid.Row="1"
                       Text="Načítám lístek…"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPlaceTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- orientační promile – malým písmem, není to hlavní informace -->
                <Label x:Name="PromileLabel"
                       Grid.Row="2"
                       Style="{StaticResource Small}"
                       TextColor="{StaticResource InkSoft}"
                       HorizontalTextAlignment="Center"
                       IsVisible="False" />

                <!-- mezery mezi řádky se dopočítají podle místa (MainPage.FitRows) -->
                <ScrollView x:Name="RowsScroll" Grid.Row="3" Margin="0,4,0,0" SizeChanged="OnRowsSizeChanged">
                    <VerticalStackLayout x:Name="RowsStack" Spacing="0">
                        <Label Text="Pívo:" Style="{StaticResource Heading}" Margin="0,0,0,-3">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="Pivo" />
                            </Label.GestureRecognizers>
                        </Label>
                        <GraphicsView x:Name="Pivo" Margin="5,0,5,2" HeightRequest="30">
                            <GraphicsView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="Pivo" />
                            </GraphicsView.GestureRecognizers>
                        </GraphicsView>

                        <Label x:Name="VinoHeader" Text="Víno:" Style="{StaticResource Heading}" Margin="0,0,0,-3">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="Vino" />
                            </Label.GestureRecognizers>
                        </Label>
                        <GraphicsView x:Name="Vino" Margin="5,0,5,2" HeightRequest="30">
                            <GraphicsView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="Vino" />
                            </GraphicsView.GestureRecognizers>
                        </GraphicsView>

                        <Label x:Name="PanakyHeader" Text="Panáky:" Style="{StaticResource Heading}" Margin="0,0,0,-3">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="Panaky" />
                            </Label.GestureRecognizers>
                        </Label>
                        <GraphicsView x:Name="Panaky" Margin="5,0,5,2" HeightRequest="30">
                            <GraphicsView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="Panaky" />
                            </GraphicsView.GestureRecognizers>
                        </GraphicsView>

                        <Label x:Name="MichackyHeader" Text="Míchačky:" Style="{StaticResource Heading}" Margin="0,0,0,-3">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="Michacky" />
                            </Label.GestureRecognizers>
                        </Label>
                        <GraphicsView x:Name="Michacky" Margin="5,0,5,2" HeightRequest="30">
                            <GraphicsView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="Michacky" />
                            </GraphicsView.GestureRecognizers>
                        </GraphicsView>

                        <Label x:Name="RowsHint" Text="(ťukni na řádek – připíšeš nebo škrtneš čárku)" Style="{StaticResource Small}" HorizontalTextAlignment="Center"
                               TextColor="{StaticResource InkSoft}" HorizontalOptions="Center" Margin="0,12,0,0" />
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <!-- event: sněhová čepice a jmelí / sekt přes okraj lístku (kreslí se podle polohy lístku) -->
        <GraphicsView x:Name="DecoView" Grid.Row="1" Margin="0,-24,0,0" InputTransparent="True" IsVisible="False" />

        <!-- Spodní lišta: Statistiky | tácek | Nastavení -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*, Auto, *"
              ColumnSpacing="8"
              Padding="12,0,12,14">

            <controls:PencilButton Grid.Column="0"
                                   Variant="Outline"
                                   Text="Statistiky"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center"
                                   Clicked="OnStatsClicked" />

            <!-- Plus jako pivní tácek -->
            <Border x:Name="PlusButton"
                    Grid.Column="1"
                    WidthRequest="88"
                    HeightRequest="88"
                    BackgroundColor="#F4E7C5"
                    Stroke="{StaticResource Pencil}"
                    StrokeThickness="4"
                    StrokeShape="Ellipse">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="3,5" Radius="10" Opacity="0.55" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPlusTapped" />
                </Border.GestureRecognizers>
                <Grid>
                    <Ellipse Stroke="{StaticResource Pencil}" StrokeThickness="1.5" StrokeDashArray="3,3" Margin="7" />
                    <!-- plus ze dvou čar = vždy přesně uprostřed -->
                    <BoxView Color="{StaticResource Pencil}" WidthRequest="32" HeightRequest="5" CornerRadius="3"
                             HorizontalOptions="Center" VerticalOptions="Center" />
                    <BoxView Color="{StaticResource Pencil}" WidthRequest="5" HeightRequest="32" CornerRadius="3"
                             HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- event: čepice / serpentýna na tácku -->
            <GraphicsView x:Name="CoasterFxView" Grid.Column="1" WidthRequest="108" HeightRequest="108"
                          HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" IsVisible="False" />

            <!-- Nastavení -->
            <controls:PencilButton Grid.Column="2"
                                   Variant="Outline"
                                   Text="Nastavení"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Clicked="OnSettingsClicked" />
        </Grid>

        <!-- event: padající sníh / konfety přes všechno (ťuknutí propouští) -->
        <GraphicsView x:Name="SnowView" Grid.RowSpan="3" InputTransparent="True" IsVisible="False" />
    </Grid>
</ContentPage>
