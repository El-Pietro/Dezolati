<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dezolati.Pages.StatsFriend"
             Title="Statistiky">
    <AbsoluteLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <Image Source="{AppThemeBinding Light=woodlight.jpg, Dark=wooddark.jpg}"
               Aspect="AspectFill"
               AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
               AbsoluteLayout.LayoutFlags="All" />

        <Frame BackgroundColor="Beige"
               CornerRadius="1"
               Padding="20"
               AbsoluteLayout.LayoutBounds="0.5, 0.5, 0.85, 0.8"
               AbsoluteLayout.LayoutFlags="All">
            <ScrollView>
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="TitleLabel" Text="Statistiky" FontFamily="Caveat" FontSize="40"
                           TextColor="Black" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="Black" />

                    <Grid x:Name="SummaryGrid" ColumnDefinitions="Auto, *" ColumnSpacing="12" RowSpacing="6" />

                    <Label Text="Poslední tahy" FontFamily="Caveat" FontSize="30" TextColor="Black" Margin="0,16,0,0" />
                    <VerticalStackLayout x:Name="HistoryList" Spacing="4" />
                </VerticalStackLayout>
            </ScrollView>
        </Frame>
        <Button Text="Zpět"
                AbsoluteLayout.LayoutBounds="0,0"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Margin="10"
                BorderColor="WhiteSmoke"
                TextColor="WhiteSmoke"
                Clicked="OnZpetClicked" />
    </AbsoluteLayout>
</ContentPage>
