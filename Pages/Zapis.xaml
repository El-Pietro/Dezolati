<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Dezolati.Controls"
             x:Class="Dezolati.Pages.Zapis"
             Title="Zápis">
    <Grid RowDefinitions="Auto, *">
        <!-- Pozadí stolu -->
        <Image Grid.RowSpan="2" Source="{AppThemeBinding Light=woodlight.jpg, Dark=wooddark.jpg}" Aspect="AspectFill" />

        <!-- Android: místo tlačítka Zpět jen odsazení pod stavovou lištou (zpět = systémové tlačítko) -->
        <BoxView Grid.Row="0" HeightRequest="0" Color="Transparent" InputTransparent="True" Margin="{DynamicResource TopBarMargin}" />
        <!-- Windows a spol. systémové Zpět nemají → tam tlačítko zůstává -->
        <controls:PencilButton Grid.Row="0" Variant="Outline" Text="Zpět" IsVisible="{OnPlatform Default=True, Android=False}"
                               HorizontalOptions="Start" Margin="{DynamicResource TopBarMargin}" Clicked="OnZpetClicked" />

        <!-- Lístek -->
        <Border Grid.Row="1" Style="{StaticResource Listek}">
            <ScrollView>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Co to bude?" Style="{StaticResource Title}" />

                    <Label Text="Piva (velké 0,5 l):" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="PivaSlider" Minimum="0" Maximum="10" Value="1" ValueChanged="OnSliderValueChanged" />
                    <Label x:Name="PivaLabel" Text="1" Style="{StaticResource Heading}" HorizontalOptions="Center" />

                    <Label Text="Víno (sklenka 2 dcl):" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="VinoSlider" Minimum="0" Maximum="10" Value="0" ValueChanged="OnSliderValueChanged" />
                    <Label x:Name="VinoLabel" Text="0" Style="{StaticResource Heading}" HorizontalOptions="Center" />

                    <Label Text="Panáky (jakékoli, 4 cl):" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="PanakySlider" Minimum="0" Maximum="10" Value="0" ValueChanged="OnSliderValueChanged" />
                    <Label x:Name="PanakyLabel" Text="0" Style="{StaticResource Heading}" HorizontalOptions="Center" />

                    <controls:PencilButton x:Name="ZapsatButton" Text="Zapsat" Variant="Primary"
                                           Margin="0,12,0,0" Clicked="OnZapsatClicked" />
                    <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Pencil}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
