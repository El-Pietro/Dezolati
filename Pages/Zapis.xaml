<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dezolati.Pages.Zapis"
             Title="Zápis">
    <AbsoluteLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">

        <!-- Pozadí stolu -->
        <Image Source="{AppThemeBinding Light=woodlight.jpg, Dark=wooddark.jpg}"
               Aspect="AspectFill"
               AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
               AbsoluteLayout.LayoutFlags="All" />

        <!-- Lístek -->
        <Frame BackgroundColor="Beige"
               CornerRadius="1"
               Padding="20"
               AbsoluteLayout.LayoutBounds="0.5, 0.5, 0.8, 0.8"
               AbsoluteLayout.LayoutFlags="All">

            <VerticalStackLayout Padding="20" Spacing="20">
                <Label Text="Zvolte množství:" FontSize="24" HorizontalOptions="Center" />

                <Label Text="Piva:" FontSize="18" />
                <Slider x:Name="PivaSlider" Minimum="0" Maximum="10" Value="1" ValueChanged="OnSliderValueChanged" />
                <Label x:Name="PivaLabel" Text="1" FontSize="14" HorizontalOptions="Center" />

                <Label Text="Víno:" FontSize="18" />
                <Slider x:Name="VinoSlider" Minimum="0" Maximum="10" Value="0" ValueChanged="OnSliderValueChanged" />
                <Label x:Name="VinoLabel" Text="0" FontSize="14" HorizontalOptions="Center" />

                <Label Text="Panáky:" FontSize="18" />
                <Slider x:Name="PanakySlider" Minimum="0" Maximum="10" Value="0" ValueChanged="OnSliderValueChanged" />
                <Label x:Name="PanakyLabel" Text="0" FontSize="14" HorizontalOptions="Center" />

                <Button Text="Zapsat" Clicked="OnZapsatClicked" BackgroundColor="Green" TextColor="White" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </Frame>
    </AbsoluteLayout>
</ContentPage>
