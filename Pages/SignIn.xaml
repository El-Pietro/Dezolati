<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dezolati.Pages.SignIn"
             Title="Přihlášení">
    <VerticalStackLayout>
        <Entry Text="{Binding Email}" />
        <Entry IsPassword="True" Text="{Binding Password}" />
        <Button Command="{Binding SignInCommand}" Text="Přihlásit se" />
        <Button Command="{Binding NavigateSignUpCommand}" Text="Ty ještě nemáš účet?! Zaregistruj se!"/>
    </VerticalStackLayout>
</ContentPage>