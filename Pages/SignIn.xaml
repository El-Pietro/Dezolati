<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Dezolati.Controls"
             x:Class="Dezolati.Pages.SignIn"
             Title="Přihlášení">
    <Grid>
        <!-- Pozadí stolu -->
        <Image Source="{AppThemeBinding Light=woodlight.jpg, Dark=wooddark.jpg}" Aspect="AspectFill" />

        <!-- Lístek -->
        <Frame Style="{StaticResource Listek}" VerticalOptions="Center" Margin="16,40">
            <ScrollView>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Dezoláti!" Style="{StaticResource Title}" />
                    <Entry Text="{Binding Email}" Placeholder="E-mail" Keyboard="Email" />
                    <Entry Text="{Binding Password}" Placeholder="Heslo" IsPassword="True"
                           ReturnCommand="{Binding SignInCommand}" />
                    <Label Text="{Binding Error}" Style="{StaticResource Error}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Pencil}" />
                    <controls:PencilButton Command="{Binding SignInCommand}" Text="Přihlásit se" Variant="Primary" />
                    <controls:PencilButton Command="{Binding NavigateSignUpCommand}" Text="Nemáš účet? Zaregistruj se!"
                                           Variant="Secondary"
                                           FontSize="{DynamicResource FontButtonSmall}"
                                           HeightRequest="{DynamicResource ButtonHeightSmall}" />
                </VerticalStackLayout>
            </ScrollView>
        </Frame>
    </Grid>
</ContentPage>
