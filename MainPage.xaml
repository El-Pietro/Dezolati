<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dezolati.MainPage"
             BackgroundImageSource="listek.png">

    <ScrollView>
        <Grid>
            <Label Text="Dezoláti!"
            FontSize="36"
            HorizontalOptions="Center"
            TextColor="black"
            FontAttributes="Bold" 
            VerticalOptions="Start"/>

            <Label x:Name="SouhrnLabel"
            Text="Dnešní spotřeba: 0 piv"
            FontSize="20"
            HorizontalOptions="Center"
            TextColor="Black"
            Margin="0,20,0,20"/>

            <FlexLayout x:Name="ListekLayout"
            Direction="Row"
            Wrap="Wrap"
            JustifyContent="Center"
            AlignItems="Start"
            BackgroundColor="Transparent"
            Margin="1"
            Padding="1" 
            VerticalOptions="Center"
            MaximumWidthRequest="250"/>

            <Button Text="+"
            FontSize="24"
            BackgroundColor="Yellow"
            TextColor="White"
            HorizontalOptions="Center"
            VerticalOptions="End"
            WidthRequest="100"
            Clicked="OnPridatClicked" />
        </Grid>
    </ScrollView>

</ContentPage>
