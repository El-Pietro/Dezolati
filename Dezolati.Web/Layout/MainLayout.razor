@namespace Dezolati.Web.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

@{ var theme = Events.Theme; }
@if (theme != null)
{
    @* event (Vánoce …) na všech stránkách: světýlka a ohňostroj na stole, sníh / konfety přes všechno,
       čepice na každém lístku (.page.ev .listek::before) – Services/EventScene.cs *@
    <div class="ev-back" aria-hidden="true">
        <svg class="ev-lights" width="1400" height="46" viewBox="0 0 1400 46">
            <path d="@EventScene.Wire(1400)" fill="none" stroke="#2F2A22" stroke-width="1.6" />
            @foreach (var (x, y, color, delay) in EventScene.Bulbs(1400, theme))
            {
                <rect x="@F(x - 2)" y="@F(y - 11)" width="4" height="5" fill="#3A3A3A" />
                <ellipse class="ev-bulb @(theme == "silvestr" ? "fast" : "")" cx="@F(x)" cy="@F(y)" rx="4.5" ry="6.5" fill="@color" style="animation-delay:@F(delay)s" />
            }
        </svg>
        @if (theme == "silvestr")
        {
            @foreach (var (sx, sy, color, r, delay) in Fireworks)
            {
                <div class="ev-fw" style="left:@F(sx * 100)%;top:@F(sy)px">
                    @for (var k = 0; k < 12; k++)
                    {
                        <span style="--a:@(k * 30)deg;--r:@F(r)px;--del:@F(delay)s;background:@color;box-shadow:0 0 4px @color"></span>
                    }
                </div>
            }
        }
    </div>
    @if (Events.Snow)
    {
        <div class="ev-snow @(theme == "silvestr" ? "confetti" : "")" aria-hidden="true">
            @foreach (var f in Flakes)
            {
                <span style="@f"></span>
            }
        </div>
    }
}
<div class="page @(theme != null ? $"ev ev-{theme}" : "")" style="@(theme != null ? CapStyle : null)">
    @if (WebPlatform.UpdateReady)
    {
        <div class="banner">Je tu nová verze. <button @onclick="Reload">Načíst</button></div>
    }
    @Body
</div>
<DialogHost />

@code {
    protected override void OnInitialized()
    {
        Events.Changed += OnEventChanged;
        WebPlatform.Changed += OnChanged;
        WebPlatform.OpenRequested += OnOpen;
    }
    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void OnOpen(string url) => InvokeAsync(() => Nav.NavigateTo(url));
    private async Task Reload() => await JS.InvokeVoidAsync("dz.reload");
    private void OnEventChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // sněhová čepice pro všechny lístky jako obrázek (CSS proměnná --ev-cap)
    private static readonly string CapStyle = "--ev-cap:url(\"data:image/svg+xml," +
        Uri.EscapeDataString($"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 358 34' preserveAspectRatio='none'>{SceneKit.ToSvg(EventScene.Cap(358))}</svg>") + "\")";

    // ohňostroj jako v appce (Services/EventScene.cs): x jako podíl šířky, y v px, barva, poloměr, zpoždění
    private static readonly (double X, double Y, string Color, double R, double Delay)[] Fireworks =
    {
        (0.18, 70, "#F2C94C", 30, 0), (0.77, 56, "#E8433A", 34, 1.3), (0.5, 40, "#C0C7D0", 26, 2.4),
        (0.88, 150, "#3C8DDE", 22, 0.7), (0.07, 180, "#F2C94C", 20, 3.1)
    };

    // padající sníh / konfety (CSS animace; barvy konfet řeší :nth-child v app.css)
    private static readonly string[] Flakes = MakeFlakes();

    private static string[] MakeFlakes()
    {
        var rnd = new Random(7);
        return Enumerable.Range(0, 46).Select(i =>
        {
            var size = 2 + rnd.NextDouble() * 4;
            return $"left:{F(rnd.NextDouble() * 100)}%;width:{F(size)}px;height:{F(i % 3 == 0 ? size : size + rnd.NextDouble() * 3)}px;" +
                   $"opacity:{F(0.55 + rnd.NextDouble() * 0.4)};animation-duration:{F(7 + rnd.NextDouble() * 8)}s;animation-delay:-{F(rnd.NextDouble() * 14)}s";
        }).ToArray();
    }

    public void Dispose()
    {
        Events.Changed -= OnEventChanged;
        WebPlatform.Changed -= OnChanged;
        WebPlatform.OpenRequested -= OnOpen;
    }
}
