@namespace Dezolati.Web.Layout
@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="page">
    @if (WebPlatform.UpdateReady)
    {
        <div class="banner">Je tu nová verze. <button @onclick="Reload">Načíst</button></div>
    }
    @Body
</div>
<DialogHost />

@code {
    protected override void OnInitialized()
    {
        WebPlatform.Changed += OnChanged;
        WebPlatform.OpenRequested += OnOpen;
    }
    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void OnOpen(string url) => InvokeAsync(() => Nav.NavigateTo(url));
    private async Task Reload() => await JS.InvokeVoidAsync("dz.reload");
    public void Dispose()
    {
        WebPlatform.Changed -= OnChanged;
        WebPlatform.OpenRequested -= OnOpen;
    }
}
