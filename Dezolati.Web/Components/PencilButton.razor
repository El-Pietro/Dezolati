@namespace Dezolati.Web.Components
@* Pastelkové tlačítko (Controls/PencilButton.cs v appce). *@
<button type="@Type" class="pencil @VariantClass @(Small ? "small" : "") @(Off ? "chip-off" : "") @Class"
        style="@Style" disabled="@Disabled" @onclick="OnClick"><span>@Text</span></button>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public PencilVariant Variant { get; set; } = PencilVariant.Primary;
    [Parameter] public bool Small { get; set; }
    /// <summary>Nevybraná volba (bledá tužka).</summary>
    [Parameter] public bool Off { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public EventCallback OnClick { get; set; }

    private string VariantClass => Variant switch
    {
        PencilVariant.Secondary => "secondary",
        PencilVariant.Danger => "danger",
        PencilVariant.Outline => "outline",
        _ => "primary"
    };
}
