@namespace Dezolati.Web.Pages
@page "/"
@implements IDisposable
@inject NavigationManager Nav

@* Lístek (Pages/MainPage v appce). Lišta jako v appce: Hospody | Hry | Přátelé. *@
@{ var theme = Events.Theme; }
<div class="topbar @(theme != null ? "ev" : "")">
    <PencilButton Variant="PencilVariant.Outline" Text="Hospody" OnClick="@(() => Nav.NavigateTo("hospody"))" />
    <div class="spacer"></div>
    <PencilButton Variant="PencilVariant.Outline" Text="Hry" OnClick="@(() => Nav.NavigateTo("hry"))" />
    <div class="spacer"></div>
    <div class="badge-wrap">
        <PencilButton Variant="PencilVariant.Outline" Text="Přátelé" OnClick="@(() => Nav.NavigateTo("pratele"))" />
        @if (FriendBadge.Count > 0)
        {
            <span class="badge">@(FriendBadge.Count > 9 ? "9+" : FriendBadge.Count.ToString())</span>
        }
    </div>
</div>

<div class="listek grow wet @(theme != null ? "ev" : "")">
    @if (theme != null)
    {
        @if (theme == "silvestr")
        {
            <svg class="ev-streamer" width="120" height="60" viewBox="0 0 120 60" aria-hidden="true">@((MarkupString)SceneKit.ToSvg(EventScene.Streamer()))</svg>
        }
        @if (theme == "vanoce")
        {
            <svg class="ev-mistletoe" width="78" height="70" viewBox="0 0 78 70" aria-hidden="true">@((MarkupString)SceneKit.ToSvg(EventScene.Mistletoe()))</svg>
        }
        else if (theme == "silvestr")
        {
        <svg class="ev-sekt" width="92" height="96" viewBox="0 0 92 96" aria-hidden="true">
          <g transform="rotate(32 46 60)">
            <!-- pěna z hrdla (za láhví, vyrůstá nahoru) -->
            <path class="sk-foam" d="M38 18 C 34 12, 38 6, 42 8 C 41 2, 48 0, 50 5 C 54 2, 59 7, 55 11 C 59 14, 56 19, 53 18 Z" fill="#FFF8DC" stroke="#E8D9A0" stroke-width="1"></path>
            <path d="M38 92 L38 52 C 38 44, 42 40, 42 32 L42 18 L50 18 L50 32 C 50 40, 54 44, 54 52 L54 92 Z" fill="#2F5A2A" stroke="#1F3D1C" stroke-width="1.2"></path>
            <path d="M41 17 L51 17 L52 34 C 52 38, 40 38, 40 34 Z" fill="#D9B13B" stroke="#A9861F" stroke-width="1"></path>
            <!-- stékající pěna po hrdle -->
            <path class="sk-drip" d="M42 17 C 41 22, 42 26, 43.5 27 C 45 26, 44 21, 45 17 Z M48 17 C 48 20, 48 23, 49.5 23.5 C 51 23, 50.5 20, 50.5 17 Z" fill="#FFF8DC" stroke="#E8D9A0" stroke-width=".8"></path>
            <rect x="38.5" y="58" width="15" height="18" rx="2" fill="#F4ECD2" stroke="#C9B98F" stroke-width="1"></rect>
            <path d="M41 63 H51 M41 67 H49 M41 71 H50" stroke="#8E1B2A" stroke-width="1.2"></path>
            <path d="M43 52 C 44 48, 44 42, 44 36" stroke="#6E9A5C" stroke-width="1.6" fill="none" opacity=".7"></path>
            <!-- špunt na hrdle; vyletí po ose láhve -->
            <g class="sk-cork" >
              <path d="M42 18 L42.5 9 C 42.5 6, 49.5 6, 49.5 9 L50 18 Z" fill="#C89B5A" stroke="#8A6630" stroke-width="1"></path>
              <path d="M43 13 H49" stroke="#8A6630" stroke-width=".8"></path>
            </g>
            <circle class="sk-bub" cx="44" cy="10" r="1.8" fill="#F7E7A6" style="--bx: -6px; animation-delay: .05s"></circle>
            <circle class="sk-bub" cx="48" cy="9" r="1.4" fill="#F7E7A6" style="--bx: 5px; animation-delay: .2s"></circle>
            <circle class="sk-bub" cx="46" cy="11" r="1.2" fill="#F7E7A6" style="--bx: -1px; animation-delay: .35s"></circle>
          </g>
        </svg>
        }
    }
    @* mokrá kolečka od piv a vín – pod čárkami, podle dne (Services/Krouzky.cs, stejně jako v appce) *@
    <svg class="rings" aria-hidden="true">
        @foreach (var r in Krouzky.For(shownDay, shownPivo, shownVino))
        {
            // poloha v % lístku, velikost v px (kruh se nesmí roztáhnout do elipsy)
            var rad = r.R * 300; var circ = rad * 2 * Math.PI;
            var color = EventScene.RingColor(theme) ?? (r.Wine ? "#7A1C2C" : "#A0661C");
            var cx = F(r.X * 100) + "%"; var cy = F(r.Y * 100) + "%";
            <g opacity="@F(r.Opacity)">
                <circle cx="@cx" cy="@cy" r="@F(rad * 0.92)" fill="@color" fill-opacity="0.18" />
                <circle cx="@cx" cy="@cy" r="@F(rad)" fill="none" stroke="@color" stroke-width="@F(Math.Max(2, r.Width * 300))"
                        stroke-linecap="round" stroke-dasharray="@F(circ * 0.86) @F(circ)" stroke-dashoffset="@F(-circ * r.Gap / 360)" />
                <circle cx="@cx" cy="@cy" r="@F(rad)" fill="none" stroke="@color" stroke-opacity="0.55"
                        transform="translate(@F(rad * 0.08) @F(-rad * 0.08))"
                        stroke-width="@F(Math.Max(1.5, r.Width * 180))" stroke-linecap="round"
                        stroke-dasharray="@F(circ * 0.44) @F(circ)" stroke-dashoffset="@F(-circ * (r.Gap / 360 + 0.39))" />
            </g>
        }
    </svg>
    <div class="title">Dezoláti!</div>
    @if (EventScene.Tag(theme, DateTime.Now) is { } tag)
    {
        @* cedulka eventu – ťuknutím detail eventu *@
        <div class="ev-tag @tag.Theme" @onclick="EventTagTapped">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">@((MarkupString)SceneKit.ToSvg(EventScene.TagIcon(tag.Theme)))</svg>
            <span class="t">@tag.Title</span>
            @if (tag.Candles >= 0)
            {
                <svg width="42" height="20" viewBox="0 0 42 20" aria-hidden="true">@((MarkupString)SceneKit.ToSvg(EventScene.Candles(tag.Candles)))</svg>
            }
            @if (tag.Detail.Length > 0)
            {
                <span class="d">@tag.Detail</span>
            }
        </div>
    }
    @* ťuknutí: ruční oprava místa („📍 …“), platí do 50 m *@
    <div class="body center pre" style="cursor:pointer" @onclick="PlaceTapped">@souhrn</div>
    @if (promile != null)
    {
        <div class="small soft center">@promile</div>
    }

    @* mezery mezi řádky rostou podle místa (.tally-gap, max. 40 px) *@
    <div class="tally-rows">
        @foreach (var (kind, label, count, seed) in Rows)
        {
            @if (kind != "Pivo")
            {
                <div class="tally-gap"></div>
            }
            <div class="tally-row" @onclick="() => RowTapped(kind)">
                <div class="heading">@label</div>
                @* čárky propiskou – stejná kresba jako v appce (Services/Carky.cs) *@
                @{ var th = TallyScene.HeightFor(count, CarkyWidth); }
                <svg class="carky-svg" width="@F(CarkyWidth)" height="@F(th)" viewBox="0 0 @F(CarkyWidth) @F(th)" aria-hidden="true">
                    @((MarkupString)SceneKit.ToSvg(TallyScene.Build(count, CarkyWidth, shownDay, seed - 1)))
                </svg>
            </div>
        }
        <div class="tally-gap"></div>
        <div class="small soft center" style="margin-top:12px">(ťukni na řádek – připíšeš nebo škrtneš čárku)</div>
    </div>
</div>

<div class="bottombar">
    <PencilButton Variant="PencilVariant.Outline" Text="Statistiky" OnClick="@(() => Nav.NavigateTo("statistiky"))" />
    <button class="coaster" aria-label="Zapsat" @onclick="@(() => Nav.NavigateTo("zapis"))"><i class="h"></i><i class="v"></i>@if (theme == "silvestr")
        {
            <svg class="ev-coaster-streamer" width="100" height="100" viewBox="0 0 100 100" aria-hidden="true">@((MarkupString)SceneKit.ToSvg(EventScene.CoasterStreamer()))</svg>
        }
        else if (theme != null)
        {
            <svg class="ev-coaster-cap" width="88" height="26" viewBox="0 0 88 26" aria-hidden="true">@((MarkupString)SceneKit.ToSvg(EventScene.CoasterCap()))</svg>
        }</button>
    <PencilButton Variant="PencilVariant.Outline" Text="Nastavení" OnClick="@(() => Nav.NavigateTo("nastaveni"))" />
</div>

@code {
    private static readonly CultureInfo Cs = WebPlatform.Cs;
    private readonly FirestoreService firestoreService = new();

    private string souhrn = "Načítám lístek…";
    private string? promile;
    private DateTime shownDay;
    private int shownPivo, shownVino, shownPanaky, shownMichacky;
    private Timer? promileTimer;
    private bool loading;

    private IEnumerable<(string Kind, string Label, int Count, int Seed)> Rows => new[]
    {
        ("Pivo", "Pívo:", shownPivo, 1),
        ("Vino", "Víno:", shownVino, 2),
        ("Panaky", "Panáky:", shownPanaky, 3),
        ("Michacky", "Míchačky:", shownMichacky, 4)
    };

    // šířka, na kterou se čárky skládají (3 pětky na řádek; na užším displeji se kresba jen zmenší)
    private const double CarkyWidth = 290;

    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        if (!AuthSession.IsSignedIn)
        {
            Nav.NavigateTo("prihlaseni", replace: true);
            return;
        }
        UserSession.DrinksChanged += OnDrinksChanged;
        FriendBadge.Changed += OnBadgeChanged;
        WebPlatform.Changed += OnDrinksChanged;   // vrátil se signál → odeslat frontu a překreslit
        promileTimer = new Timer(_ => InvokeAsync(() => { UpdatePromile(); StateHasChanged(); }), null,
            TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
        await LoadData();

        // čekající žádosti o přátelství (jen při spuštění / návratu / oznámení) a token pro oznámení
        _ = FriendBadge.RefreshAsync();
        _ = WebPush.RefreshAsync();
        Events.Changed += OnEventChanged;
        _ = Events.EnsureAsync();   // event (Vánoce …): max. 1× za 12 h
        _ = ShowNewBadgesAsync();
    }

    private void OnBadgeChanged() => InvokeAsync(StateHasChanged);

    private void OnDrinksChanged() => InvokeAsync(async () => { await LoadData(); StateHasChanged(); });

    private void UpdatePromile()
    {
        var est = AuthSession.Uid is string uid ? Promile.Estimate(uid, UserSession.Profile?.Gender) : null;
        promile = est is { } e
            ? $"≈ {e.Promile.ToString("0.0", Cs)} ‰ · {Promile.SoberText(e.SoberAtLocal, UserSession.Profile?.Gender)} · jen odhad, neřiď podle toho"
            : null;
    }

    private async Task LoadData()
    {
        if (loading) return;
        var userId = AuthSession.Uid;
        if (userId == null)
        {
            Nav.NavigateTo("prihlaseni", replace: true);
            return;
        }

        loading = true;
        try
        {
            await UserSession.EnsureReadyAsync();
            var day = UserSession.CurrentPubDay;

            await DrinkQueue.FlushAsync(userId);

            DailyDrinksModel? today;
            var offline = !Net.IsOnline;
            if (offline || LocalCache.IsFresh(userId, day))
            {
                today = LocalCache.LoadDaily(userId, day);
            }
            else
            {
                try
                {
                    today = await firestoreService.GetDailyDrinks(userId, day);
                    LocalCache.SaveDaily(userId, day, today);
                    LocalCache.MarkFresh(userId, day);
                }
                catch (Exception ex) when (Net.IsNetworkError(ex))
                {
                    today = LocalCache.LoadDaily(userId, day);
                    offline = true;
                }
            }

            RenderWithPending(userId, day, today, offline);
        }
        catch (AuthException)
        {
            Nav.NavigateTo("prihlaseni", replace: true);
        }
        catch (Exception ex)
        {
            if (TryRenderFromCache(userId)) souhrn += "\n(nepodařilo se načíst ze serveru)";
            else souhrn = "Lístek se nepodařilo načíst.";
            if (!Net.IsNetworkError(ex))
                await Note.AlertAsync("Chyba", "Chyba při načítání dat: " + ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private void RenderWithPending(string userId, DateTime day, DailyDrinksModel? today, bool offline)
    {
        var pending = DrinkQueue.PendingFor(userId, day);
        shownDay = day;
        Render(Math.Max(0, (today?.Pivo ?? 0) + pending.Pivo),
               Math.Max(0, (today?.Vino ?? 0) + pending.Vino),
               Math.Max(0, (today?.Panaky ?? 0) + pending.Panaky),
               pending.Count, offline,
               Math.Max(0, (today?.Michacky ?? 0) + pending.Michacky));
    }

    private bool TryRenderFromCache(string userId)
    {
        try
        {
            var day = UserSession.CurrentPubDay;
            RenderWithPending(userId, day, LocalCache.LoadDaily(userId, day), offline: true);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private void Render(int pivo, int vino, int panaky, int pendingCount, bool offline, int michacky = 0)
    {
        shownPivo = pivo;
        shownVino = vino;
        shownPanaky = panaky;
        shownMichacky = michacky;

        var text = pivo + vino + panaky + michacky == 0
            ? "Zatím čistý lístek."
            : "Dnes: " + Cz.Souhrn(pivo, vino, panaky, michacky);

        if (AuthSession.Uid is string uid && PushService.LastPubName(uid, shownDay) is string pub)
            text += $"\n📍 {(pub == "doma" ? "Doma" : pub)}";

        if (pendingCount > 0)
            text += $"\n({Cz.Plural(pendingCount, "zápis čeká", "zápisy čekají", "zápisů čeká")} na signál)";
        else if (offline)
            text += "\n(bez signálu)";

        souhrn = text;
        UpdatePromile();
    }

    /// <summary>Ťuknutí na řádek lístku → připsat, nebo škrtnout jednu čárku (každý druh zvlášť).</summary>
    private async Task RowTapped(string kind)
    {
        var userId = AuthSession.Uid;
        if (userId == null) return;

        var (count, name, one) = kind switch
        {
            "Pivo" => (shownPivo, "Pívo", "jedno pivo"),
            "Vino" => (shownVino, "Víno", "jedno víno"),
            "Michacky" => (shownMichacky, "Míchačky", "jednu míchačku"),
            _ => (shownPanaky, "Panáky", "jednoho panáka")
        };

        var add = $"Zapsat {one}";
        var strike = $"Odmazat {one}";
        var choice = count > 0
            ? await Note.ShowAsync($"{name}: {count}", "Co s tím?",
                (add, PencilVariant.Primary), (strike, PencilVariant.Danger), ("Nic", PencilVariant.Secondary))
            : await Note.ShowAsync($"{name}: zatím nic", "Připsat čárku?",
                (add, PencilVariant.Primary), ("Nic", PencilVariant.Secondary));

        int p = kind == "Pivo" ? 1 : 0, v = kind == "Vino" ? 1 : 0, s = kind == "Panaky" ? 1 : 0, m = kind == "Michacky" ? 1 : 0;
        try
        {
            if (choice == add)
                await firestoreService.RecordDrink(userId, AuthSession.DisplayName, p, v, s, michacky: m);
            else if (choice == strike)
                await firestoreService.RecordCorrection(userId, shownDay, p, v, s, m);
            else
                return;
        }
        catch (Exception ex)
        {
            await Note.AlertAsync("Chyba", (choice == add ? "Zápis" : "Škrtnutí") + " se nepovedl: " + ex.Message);
        }
        await LoadData();
    }

    // ---------------- event (Vánoce …) ----------------

    private void OnEventChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    /// <summary>Ruční oprava místa: appka se spletla (doma vs. hospoda vedle) → vybrat, kde opravdu sedím.</summary>
    private async Task PlaceTapped()
    {
        if (shownDay.Date != UserSession.CurrentPubDay.Date) return;   // jen dnešek
        if (!PushService.DetectPub)
        {
            await Note.AlertAsync("Kde sedím", "Poznávání místa máš vypnuté v Nastavení.");
            return;
        }
        ((double Lat, double Lon) Me, List<PlaceChoice> Choices)? loaded;
        using (Note.Busy("Kde sedím", "Zjišťuju, kde jsi…")) loaded = await PlaceChoices.LoadAsync(shownDay);
        if (loaded is not { } l)
        {
            await Note.AlertAsync("Kde sedím", Dezolati.Web.WebGeo.Explain(Dezolati.Web.WebGeo.LastError));
            return;
        }
        var pick = await Note.ShowAsync("Kde opravdu sedíš?",
            "Platí pro další zápisy, dokud neodejdeš dál než 50 m. Pak se místo zase pozná samo.",
            l.Choices.Select((c, i) => (c.Label, i == 0 ? PencilVariant.Primary : PencilVariant.Secondary)).ToArray());
        if (l.Choices.FirstOrDefault(c => c.Label == pick) is not { } choice) return;
        PlaceChoices.Choose(choice, l.Me, shownDay);
        await LoadData();
        StateHasChanged();
    }

    /// <summary>Okno „Nový odznak“ (nejvýš 1× za 10 min; jen když běží event).</summary>
    private async Task ShowNewBadgesAsync()
    {
        foreach (var b in await Badges.CheckNewAsync())
        {
            var r = await Note.ShowAsync($"Nový odznak: {b.Name}!", b.Desc,
                ("Na zdraví!", PencilVariant.Primary), ("Ukázat odznaky", PencilVariant.Secondary));
            if (r == "Ukázat odznaky")
            {
                Nav.NavigateTo("statistiky");
                return;
            }
        }
    }

    private void EventTagTapped() => Nav.NavigateTo("trhy");   // detail eventu: trhy poblíž, „Tady jsou trhy!“, odznaky, mapa

    public void Dispose()
    {
        Events.Changed -= OnEventChanged;
        UserSession.DrinksChanged -= OnDrinksChanged;
        FriendBadge.Changed -= OnBadgeChanged;
        WebPlatform.Changed -= OnDrinksChanged;
        promileTimer?.Dispose();
    }
}
